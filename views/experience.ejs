<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Experience | Isaiah Rodriguez</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="page-header">
    <%- include('partials/nav') %>

    <h1>Experience</h1>
    <p>Professional experience, education, and certifications.</p>
  </header>

  <main>

    <section class="experience-section">
  <p class="section-label">Career</p>
  <h2>Professional Experience</h2>

  <div class="timeline">

    <% experience.forEach(item => { %>

      <article class="timeline-item">

        <div class="timeline-marker"></div>

        <div class="timeline-period">
          <%= item.period %>
        </div>

        <div class="timeline-content">
          <h3><%= item.role %></h3>

          <p class="company">
            <%= item.company %>
          </p>

          <ul>
            <% item.bullets.forEach(bullet => { %>
              <li><%= bullet %></li>
            <% }) %>
          </ul>
        </div>

      </article>

    <% }) %>

  </div>
</section>

    <section class="education-section">
  <p class="section-label">Background</p>
  <h2>Education & Certifications</h2>

  <div class="education-layout">

    <div class="education-block">
      <h3>Education</h3>

      <% education.forEach(item => { %>
        <div class="education-entry">
          <span class="education-year"><%= item.period %></span>

          <div>
            <h4><%= item.degree %></h4>
            <p><%= item.school %></p>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="education-block">
      <h3>Certifications</h3>

      <div class="certification-list">
        <% certifications.forEach(cert => { %>
          <span class="certification"><%= cert %></span>
        <% }) %>
      </div>
    </div>

  </div>
</section>

  </main>

</body>
</html>