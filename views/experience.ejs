<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Experience | Isaiah Rodriguez</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="page-header">
    <nav>
      <a href="/">Home</a>
      <a href="/skills">Skills</a>
      <a href="/experience">Experience</a>
      <a href="/projects">Projects</a>
      <a href="/resume/Isaiah-Rodriguez-Resume.pdf" target="_blank">Resume</a>
      <a href="/contact">Contact</a>
      <a href="https://github.com/isaiahr06" target="_blank">GitHub</a>
    </nav>

    <h1>Experience</h1>
    <p>Professional experience, education, and certifications.</p>
  </header>

  <main>

    <section class="experience-section">
      <h2>Professional Experience</h2>

      <div class="experience-list">

        <% experience.forEach(item => { %>

          <article class="experience-card">

            <div class="experience-header">
              <div>
                <h3><%= item.role %></h3>
                <p class="company"><%= item.company %></p>
              </div>

              <span class="experience-period">
                <%= item.period %>
              </span>
            </div>

            <ul>
              <% item.bullets.forEach(bullet => { %>
                <li><%= bullet %></li>
              <% }) %>
            </ul>

          </article>

        <% }) %>

      </div>
    </section>

    <section class="education-section">
      <h2>Education & Certifications</h2>

      <div class="education-grid">

        <div class="education-card">
          <h3>Education</h3>

          <% education.forEach(item => { %>
            <div class="education-item">
              <h4><%= item.degree %></h4>
              <p><%= item.school %></p>
              <span><%= item.period %></span>
            </div>
          <% }) %>
        </div>

        <div class="education-card">
          <h3>Certifications</h3>

          <div class="certification-list">
            <% certifications.forEach(cert => { %>
              <span class="certification"><%= cert %></span>
            <% }) %>
          </div>
        </div>

      </div>
    </section>

  </main>

</body>
</html>