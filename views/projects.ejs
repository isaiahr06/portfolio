<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Projects | Isaiah Rodriguez</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="page-header">

    <%- include('partials/nav') %>

    <h1>Projects</h1>

    <p>A selection of applications I've built and deployed.</p>

  </header>


  <main>

    <section class="projects-page">

      <% const featuredProject = projects[0]; %>
      <% const otherProjects = projects.slice(1); %>


      <!-- =========================
           FEATURED PROJECT
      ========================== -->

      <div class="featured-project">

        <div class="featured-project-image-wrap">

          <img
            src="<%= featuredProject.image %>"
            alt="<%= featuredProject.name %> preview"
            class="featured-project-image"
          >

        </div>


        <div class="featured-project-content">

          <p class="section-label">Featured Project</p>

          <h2><%= featuredProject.name %></h2>

          <p class="featured-description">
            <%= featuredProject.description %>
          </p>


          <div class="project-tech-list featured-tech-list">

            <% featuredProject.tech.split(',').forEach(item => { %>

              <span><%= item.trim() %></span>

            <% }) %>

          </div>


          <div class="featured-actions">

            <a
              href="<%= featuredProject.liveUrl %>"
              target="_blank"
              rel="noopener noreferrer"
              class="primary-button"
            >
              View Live Project
            </a>

            <a
              href="<%= featuredProject.githubUrl %>"
              target="_blank"
              rel="noopener noreferrer"
              class="secondary-button"
            >
              GitHub
            </a>

          </div>

        </div>

      </div>


      <!-- =========================
           OTHER PROJECTS
      ========================== -->

      <div class="more-projects-heading">

        <p class="section-label">More Work</p>

        <h2>Other Projects</h2>

      </div>


      <div class="other-projects-grid">

        <% otherProjects.forEach(project => { %>

          <article class="project-card">


            <!-- Project Image -->

            <div class="project-image-wrap">

              <img
                src="<%= project.image %>"
                alt="<%= project.name %> preview"
                class="project-image"
              >

            </div>


            <!-- Project Information -->

            <div class="project-card-content">

              <h3><%= project.name %></h3>

              <p class="project-description">
                <%= project.description %>
              </p>


              <!-- Technology Pills -->

              <div class="project-tech-list">

                <% project.tech.split(',').forEach(item => { %>

                  <span><%= item.trim() %></span>

                <% }) %>

              </div>


              <!-- Project Buttons -->

              <div class="project-actions">

                <a
                  href="<%= project.liveUrl %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="primary-button"
                >
                  View Live Project
                </a>

                <a
                  href="<%= project.githubUrl %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="secondary-button"
                >
                  GitHub
                </a>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    </section>

  </main>

</body>

</html>