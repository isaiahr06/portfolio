<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Skills | Isaiah Rodriguez</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="page-header">
    <%- include('partials/nav') %>

    <h1>Skills</h1>
    <p>Technologies and tools I've worked with across frontend and backend development.</p>
  </header>

  <main>
    <section class="skills-page">

  <div class="skills-heading">
    <p class="section-label">Toolbox</p>
    <h2>Technical Skills</h2>

    <p>
      Technologies and tools I’ve worked with across frontend,
      backend, databases, and development workflows.
    </p>
  </div>

  <div class="skills-stack">

    <% skills.forEach((skill, index) => { %>

      <article class="skill-row">

        <div class="skill-number">
          0<%= index + 1 %>
        </div>

        <div class="skill-category">
          <h3><%= skill.category %></h3>
        </div>

        <div class="skill-items">
          <% skill.items.forEach(item => { %>
            <span><%= item %></span>
          <% }) %>
        </div>

      </article>

    <% }) %>

  </div>

</section>
  </main>

</body>
</html>